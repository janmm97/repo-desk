# Repositories to watch, comma-separated (owner/repo).
REPOS=owner/repo

# Optional: One connection keys. Leave empty and repo-desk picks your only
# GitHub / Slack connection from `one --agent list`. Keys are not secrets on
# their own (One holds the tokens), but keep them out of git anyway.
ONE_GITHUB_KEY=
ONE_SLACK_KEY=

# Optional: path to the One CLI entry (a .js file or an executable).
# Default: `one` on PATH, or on Windows %APPDATA%\npm\node_modules\@withone\cli\bin\cli.js
ONE_BIN=

# LM Studio (OpenAI-compatible server). Leave LMSTUDIO_URL empty for the default.
LMSTUDIO_URL=http://127.0.0.1:1234/v1
CHAT_MODEL=qwen/qwen3.5-4b
EMBED_MODEL=text-embedding-nomic-embed-text-v1.5

# Cosine similarity at or above which an issue is flagged as a possible duplicate.
DUP_THRESHOLD=0.85

# Where state is kept (issue text, embeddings, suggestions). Default: ./.repo-desk
REPO_DESK_HOME=

# Desk port (bound to 127.0.0.1 only).
DESK_PORT=4317
